import ModalityInference.Proofs.ComparisonObserverTheory
import ModalityInference.Proofs.ComparisonWitnessProperties

/-! The finite comparison basis and its reconstructed polynomials lie in the
modal interval generated by their fixed heads. -/
namespace ModalityInference.ComparisonAlgebra

namespace Carrier

@[simp] theorem atMode_type (a : Carrier Δ shape) (m : Mode) :
    (a.atMode m).type = .modal a.type (.const m) := rfl

def joinList (head : CompareTy) (rest : List CompareTy)
    (hh : ∀ t ∈ head :: rest, Representable Δ shape t) : Carrier Δ shape where
  type := ComparisonInterpolation.join head rest
  shaped := (ComparisonInterpolation.join_commonShape
    (fun t ht => ⟨(hh t ht).1, (hh t ht).2.2⟩)).1
  defined := (ComparisonInterpolation.join_defined_iff _ _ _).mpr
    (fun t ht => (hh t ht).2.1)
  shape_eq := (ComparisonInterpolation.join_commonShape
    (fun t ht => ⟨(hh t ht).1, (hh t ht).2.2⟩)).2

def meetList (head : CompareTy) (rest : List CompareTy)
    (hh : ∀ t ∈ head :: rest, Representable Δ shape t) : Carrier Δ shape where
  type := ComparisonInterpolation.meet head rest
  shaped := (ComparisonInterpolation.meet_commonShape
    (fun t ht => ⟨(hh t ht).1, (hh t ht).2.2⟩)).1
  defined := (ComparisonInterpolation.meet_defined_iff _ _ _).mpr
    (fun t ht => (hh t ht).2.1)
  shape_eq := (ComparisonInterpolation.meet_commonShape
    (fun t ht => ⟨(hh t ht).1, (hh t ht).2.2⟩)).2

theorem member_le_joinList (head : CompareTy) (rest : List CompareTy)
    (hh : ∀ t ∈ head :: rest, Representable Δ shape t) {t : CompareTy} (ht : t ∈ head :: rest) :
    AlgebraSubtype Δ t (joinList head rest hh).type := by
  induction rest generalizing head with
  | nil =>
    obtain rfl := List.mem_singleton.mp ht
    exact .refl (hh t List.mem_cons_self).1
  | cons next rest ih =>
    rcases List.mem_cons.mp ht with rfl | ht
    · exact .shaped (.joinLeft (joinList t (next :: rest) hh).shaped)
    · exact (ih next (fun t ht => hh t (List.mem_cons_of_mem _ ht)) ht).trans
        (.shaped (.joinRight (joinList head (next :: rest) hh).shaped))

theorem meetList_le_member (head : CompareTy) (rest : List CompareTy)
    (hh : ∀ t ∈ head :: rest, Representable Δ shape t) {t : CompareTy} (ht : t ∈ head :: rest) :
    AlgebraSubtype Δ (meetList head rest hh).type t := by
  induction rest generalizing head with
  | nil =>
    obtain rfl := List.mem_singleton.mp ht
    exact .refl (hh t List.mem_cons_self).1
  | cons next rest ih =>
    rcases List.mem_cons.mp ht with rfl | ht
    · exact .shaped (.meetLeft (meetList t (next :: rest) hh).shaped)
    · exact (AlgebraSubtype.shaped (.meetRight (meetList head (next :: rest) hh).shaped)).trans
        (ih next (fun t ht => hh t (List.mem_cons_of_mem _ ht)) ht)

theorem meetList_le_joinList (head : CompareTy) (rest : List CompareTy)
    (hh : ∀ t ∈ head :: rest, Representable Δ shape t) :
    meetList head rest hh ≤ joinList head rest hh :=
  (meetList_le_member head rest hh List.mem_cons_self).trans
    (member_le_joinList head rest hh List.mem_cons_self)

theorem bottom_le_self (a : Carrier Δ shape) : a.atMode Mode.bottom ≤ a :=
  (AlgebraSubtype.congr (.refl a.shaped)
    (.valid fun _ _ => ⟨Mode.bottom, Mode.identity, rfl, rfl, by decide⟩)).trans
      (.shaped (.identity a.shaped))

theorem self_le_top (a : Carrier Δ shape) : a ≤ a.atMode Mode.top :=
  (AlgebraSubtype.shaped (.identityRev a.shaped)).trans
    (.congr (.refl a.shaped)
      (.valid fun _ _ => ⟨Mode.identity, Mode.top, rfl, rfl, by decide⟩))

theorem bottom_le_act {a x : Carrier Δ shape} (hx : a.atMode Mode.bottom ≤ x)
    (m : GuardedMode Δ) : a.atMode Mode.bottom ≤ m.act x := by
  have hb : Submode Δ (.const Mode.bottom) (.compose (.const Mode.bottom) m.expression) :=
    .valid fun η hη => ⟨Mode.bottom, Mode.bottom.compose (m.value η), rfl,
      by simp [ModExpr.eval, m.eval η hη], by simp [Mode.le, Mode.bottom, Mode.compose]⟩
  exact (AlgebraSubtype.congr (.refl a.shaped) hb).trans
    ((AlgebraSubtype.shaped (.composeRev a.shaped)).trans
      (.congr hx (.valid fun η hη => ⟨_, _, m.eval η hη, m.eval η hη, Mode.le_refl _⟩)))

theorem act_le_top {b x : Carrier Δ shape} (hx : x ≤ b.atMode Mode.top)
    (m : GuardedMode Δ) : m.act x ≤ b.atMode Mode.top := by
  have ht : Submode Δ (.compose (.const Mode.top) m.expression) (.const Mode.top) :=
    .valid fun η hη => ⟨Mode.top.compose (m.value η), Mode.top,
      by simp [ModExpr.eval, m.eval η hη], rfl, by simp [Mode.le, Mode.top, Mode.compose]⟩
  exact (AlgebraSubtype.congr hx
    (.valid fun η hη => ⟨_, _, m.eval η hη, m.eval η hη, Mode.le_refl _⟩)).trans
      ((AlgebraSubtype.shaped (.compose b.shaped)).trans (.congr (.refl b.shaped) ht))

end Carrier

def InInterval (lower upper : Carrier Δ shape) (t : CompareTy) : Prop :=
  ∃ h : Representable Δ shape t, lower ≤ represented h ∧ represented h ≤ upper

namespace InInterval

theorem of_carrier {lower upper t : Carrier Δ shape} (hl : lower ≤ t) (hu : t ≤ upper) :
    InInterval lower upper t.type := ⟨⟨t.shaped, t.defined, t.shape_eq⟩, hl, hu⟩

theorem join {lower upper : Carrier Δ shape} {a b : CompareTy}
    (ha : InInterval lower upper a) (hb : InInterval lower upper b) :
    InInterval lower upper (.join a b) := by
  obtain ⟨ha, hla, hau⟩ := ha
  obtain ⟨hb, hlb, hbu⟩ := hb
  exact of_carrier (t := (represented ha).join (represented hb))
    (hla.trans (Carrier.le_join_left _ _)) (Carrier.join_le hau hbu)

theorem meet {lower upper : Carrier Δ shape} {a b : CompareTy}
    (ha : InInterval lower upper a) (hb : InInterval lower upper b) :
    InInterval lower upper (.meet a b) := by
  obtain ⟨ha, hla, hau⟩ := ha
  obtain ⟨hb, hlb, hbu⟩ := hb
  exact of_carrier (t := (represented ha).meet (represented hb))
    (Carrier.le_meet hla hlb) ((Carrier.meet_le_left _ _).trans hau)

theorem modal {a b : Carrier Δ shape} {t : CompareTy} {m : ModExpr}
    (ht : InInterval (a.atMode Mode.bottom) (b.atMode Mode.top) t)
    (hm : DefinedMode Δ m) :
    InInterval (a.atMode Mode.bottom) (b.atMode Mode.top) (.modal t m) := by
  obtain ⟨ht, hlo, hhi⟩ := ht
  exact of_carrier (t := (GuardedMode.ofDefined m hm).act (represented ht))
    (Carrier.bottom_le_act hlo _) (Carrier.act_le_top hhi _)

theorem reify {lower upper : Carrier Δ shape} {basis : List CompareTy}
    {clauses : CNF} {t : CompareTy}
    (h : ComparisonPropagation.reify basis clauses = some t)
    (types : TypeVar → CompareTy) (modes : ModVar → ModExpr)
    (hb : ∀ a ∈ basis, InInterval lower upper (a.subst types modes)) :
    InInterval lower upper (t.subst types modes) :=
  ComparisonPropagation.reify_property h (fun a => InInterval lower upper (a.subst types modes)) hb
    (fun _ _ => join) (fun _ _ => meet)

end InInterval

end ModalityInference.ComparisonAlgebra

namespace ModalityInference.ComparisonControls

open ComparisonAlgebra

theorem Basis.carrier_interval (b : Basis) (ts : TypeVar → CompareTy) (ms : ModVar → ModExpr)
    (hh : ∀ a ∈ b.heads, Representable Δ shape (a.subst ts ms))
    (hm : ∀ v ∈ b.modes, DefinedMode Δ (ms v)) :
    ∃ lower upper : Carrier Δ shape,
      lower.type = (ComparisonInterpolation.meet b.head b.rest).subst ts ms ∧
      upper.type = (ComparisonInterpolation.join b.head b.rest).subst ts ms ∧
      lower ≤ upper ∧
      (∀ a ∈ b.heads, InInterval (lower.atMode Mode.bottom) (upper.atMode Mode.top) (a.subst ts ms)) ∧
      (∀ a ∈ b.types, InInterval (lower.atMode Mode.bottom) (upper.atMode Mode.top) (a.subst ts ms)) ∧
      (∀ p ∈ b.modalPairs,
        InInterval (lower.atMode Mode.bottom) (upper.atMode Mode.top) (p.1.subst ts ms)) := by
  have hh' : ∀ a ∈ b.head.subst ts ms :: b.rest.map (CompareTy.subst ts ms),
      Representable Δ shape a := by
    intro a ha
    rcases List.mem_cons.mp ha with rfl | ha
    · exact hh b.head List.mem_cons_self
    · obtain ⟨t, ht, rfl⟩ := List.mem_map.mp ha
      exact hh t (List.mem_cons_of_mem _ ht)
  let lower := Carrier.meetList (b.head.subst ts ms) (b.rest.map (CompareTy.subst ts ms)) hh'
  let upper := Carrier.joinList (b.head.subst ts ms) (b.rest.map (CompareTy.subst ts ms)) hh'
  have hlu : lower ≤ upper := Carrier.meetList_le_joinList _ _ hh'
  have hle : lower.type = (ComparisonInterpolation.meet b.head b.rest).subst ts ms :=
    (ComparisonInterpolation.meet_subst ts ms b.head b.rest).symm
  have hue : upper.type = (ComparisonInterpolation.join b.head b.rest).subst ts ms :=
    (ComparisonInterpolation.join_subst ts ms b.head b.rest).symm
  have hbt : lower.atMode Mode.bottom ≤ upper.atMode Mode.top :=
    Carrier.atMode_le hlu (by decide)
  have hbottom : InInterval (lower.atMode Mode.bottom) (upper.atMode Mode.top)
      (b.bottom.subst ts ms) := by
    simpa only [Carrier.atMode_type, hle, Basis.bottom, CompareTy.subst, ModExpr.subst] using
      InInterval.of_carrier (t := lower.atMode Mode.bottom) (le_refl _) hbt
  have htop : InInterval (lower.atMode Mode.bottom) (upper.atMode Mode.top)
      (b.top.subst ts ms) := by
    simpa only [Carrier.atMode_type, hue, Basis.top, CompareTy.subst, ModExpr.subst] using
      InInterval.of_carrier (t := upper.atMode Mode.top) hbt (le_refl _)
  have hheads : ∀ a ∈ b.heads,
      InInterval (lower.atMode Mode.bottom) (upper.atMode Mode.top) (a.subst ts ms) := by
    intro a ha
    have ha' : a.subst ts ms ∈ b.head.subst ts ms :: b.rest.map (CompareTy.subst ts ms) := by
      simpa only [Basis.heads, List.map_cons] using List.mem_map_of_mem (f := CompareTy.subst ts ms) ha
    exact ⟨hh a ha, lower.bottom_le_self.trans (Carrier.meetList_le_member _ _ hh' ha'),
      (Carrier.member_le_joinList _ _ hh' ha').trans upper.self_le_top⟩
  have htypes : ∀ a ∈ b.types,
      InInterval (lower.atMode Mode.bottom) (upper.atMode Mode.top) (a.subst ts ms) := by
    intro a ha
    obtain ⟨key, hk, rfl⟩ := List.mem_map.mp ha
    cases key with
    | head t => exact hheads t (by simpa [Basis.keys] using hk)
    | bottom => exact hbottom
    | top => exact htop
    | raised => exact InInterval.modal hbottom (fun _ _ => rfl)
    | localFloor | affineFloor => exact InInterval.modal htop (fun _ _ => rfl)
    | control c =>
      have hc : c ∈ b.modes.flatMap controls := by simpa [Basis.keys] using hk
      obtain ⟨v, hv, hc⟩ := List.mem_flatMap.mp hc
      apply InInterval.modal ?_ (control_subst_defined c ms ((controls_name_mem hc).symm ▸ hm v hv))
      change InInterval _ _ ((if c.channel == .lower then b.bottom else b.top).subst ts ms)
      split <;> assumption
  refine ⟨lower, upper, hle, hue, hlu, hheads, htypes, ?_⟩
  intro p hp
  rcases List.mem_append.mp hp with hp | hp
  · simp only [List.mem_cons, List.not_mem_nil, or_false] at hp
    rcases hp with rfl | rfl | rfl | rfl | rfl
    · simpa only [hle] using InInterval.of_carrier (t := lower)
        lower.bottom_le_self (hlu.trans upper.self_le_top)
    · simpa only [hue] using InInterval.of_carrier (t := upper)
        (lower.bottom_le_self.trans hlu) upper.self_le_top
    · exact hbottom
    · exact htop
    · exact htop
  · obtain ⟨c, _, rfl⟩ := List.mem_map.mp hp
    change InInterval _ _ ((if c.channel == .lower then b.bottom else b.top).subst ts ms)
    split <;> assumption

end ModalityInference.ComparisonControls
