import ModalityInference.Proofs.ComparisonRankedBasis
import ModalityInference.Proofs.ComparisonObserverGenerated

/-! Concrete finite ranked-basis certificates for shared signed subtype
constraints in a context with no finite declared shape model. A consistent
certificate reconstructs finite terms generated by that exact basis. -/
namespace ModalityInference.ComparisonRankedBasis

open ComparisonAlgebra ComparisonControls ComparisonStructuralLattice
open ComparisonObserverChains ComparisonInterpolation

noncomputable def generators {Δ : Bounds}
    (hn : ¬∃ρ, ComparisonShape.Models Δ ρ)
    (names : List TypeVar) (modes : List ModVar) (n : Nat) : Finset (Order Δ .unit) := by
  classical
  exact ((basis names modes n).types.attach.map fun a =>
    Order.of (represented (types_representable hn names modes n a.val a.property))).toFinset

theorem mem_generators {Δ : Bounds} (hn : ¬∃ρ, ComparisonShape.Models Δ ρ)
    (names : List TypeVar) (modes : List ModVar) (n : Nat)
    {a : CompareTy} (ha : a∈(basis names modes n).types)
    (hr : Representable Δ .unit a) :
    Order.of (represented hr)∈generators hn names modes n := by
  classical
  apply List.mem_toFinset.mpr
  exact List.mem_map.mpr ⟨⟨a,ha⟩,List.mem_attach _ _,rfl⟩

theorem generators_mono {Δ : Bounds} (hn : ¬∃ρ, ComparisonShape.Models Δ ρ)
    (names : List TypeVar) (modes : List ModVar) {n k : Nat} (h : n≤k) :
    generators hn names modes n ⊆ generators hn names modes k := by
  classical
  intro x hx
  obtain ⟨a,_,rfl⟩ := List.mem_map.mp (List.mem_toFinset.mp hx)
  exact mem_generators hn names modes k (types_mono h a.property) _

theorem certificate_mono {I : Type*} {Δ : Bounds}
    (hn : ¬∃ρ, ComparisonShape.Models Δ ρ) (names : List TypeVar) (modes : List ModVar)
    (r : Constraints I (Order Δ .unit)) {n k : Nat} (h : n≤k)
    (hc : (r.system.quotient (generators hn names modes n)).Consistent) :
    (r.system.quotient (generators hn names modes k)).Consistent := by
  apply (r.system.consistent_iff _).mpr
  intro i f hb
  have hs := generators_mono hn names modes h
  exact (r.system.consistent_iff _).mp hc i f
    ⟨r.system.reaches_restrict hs hb.1,r.system.reaches_restrict hs hb.2⟩

theorem lattice_generated {Δ : Bounds} (hn : ¬∃ρ, ComparisonShape.Models Δ ρ)
    (names : List TypeVar) (modes : List ModVar) (n : Nat)
    {a : CompareTy} (ha : LatticeForm (basis names modes n).types a)
    (hr : Representable Δ .unit a) :
    LatticeGenerated (generators hn names modes n) (Order.of (represented hr)) := by
  induction ha with
  | atom ha => exact .atom (mem_generators hn names modes n ha hr)
  | join ha hb iha ihb =>
    exact .sup (iha (ha.representable (types_representable hn names modes n)))
      (ihb (hb.representable (types_representable hn names modes n)))
  | meet ha hb iha ihb =>
    exact .inf (iha (ha.representable (types_representable hn names modes n)))
      (ihb (hb.representable (types_representable hn names modes n)))

theorem generated_lattice {Δ : Bounds} (hn : ¬∃ρ, ComparisonShape.Models Δ ρ)
    (names : List TypeVar) (modes : List ModVar) (n : Nat)
    {x : Order Δ .unit} (hx : LatticeGenerated (generators hn names modes n) x) :
    ∃a, LatticeForm (basis names modes n).types a ∧
      ∃hr : Representable Δ .unit a, Order.of (represented hr)=x := by
  classical
  induction hx with
  | atom hx =>
    obtain ⟨a,_,rfl⟩ := List.mem_map.mp (List.mem_toFinset.mp hx)
    exact ⟨a.val,.atom a.property,types_representable hn names modes n a.val a.property,rfl⟩
  | sup hx hy ihx ihy =>
    obtain ⟨a,ha,har,hax⟩ := ihx
    obtain ⟨b,hb,hbr,hby⟩ := ihy
    refine ⟨.join a b,.join ha hb,representable_typeOp true har hbr,?_⟩
    change Order.of (represented har)⊔Order.of (represented hbr)=_
    rw [hax,hby]
  | inf hx hy ihx ihy =>
    obtain ⟨a,ha,har,hax⟩ := ihx
    obtain ⟨b,hb,hbr,hby⟩ := ihy
    refine ⟨.meet a b,.meet ha hb,representable_typeOp false har hbr,?_⟩
    change Order.of (represented har)⊓Order.of (represented hbr)=_
    rw [hax,hby]

theorem carrier_generated {Δ : Bounds} (hn : ¬∃ρ, ComparisonShape.Models Δ ρ)
    (names : List TypeVar) (modes : List ModVar) {n : Nat}
    (a : Carrier Δ .unit) (hs : Supports (·∈names) (·∈modes) a.type)
    (hr : rank a.type≤n) :
    LatticeGenerated (generators hn names modes n) (Order.of a) := by
  obtain ⟨t,ht,htr,he⟩ := (normal_of_supported hn names modes a.defined hs).mono hr
  have hq : Order.of a=Order.of (represented htr) := Quotient.sound he
  exact hq.symm ▸ lattice_generated hn names modes n ht htr

private theorem lattice_supported {names : List TypeVar} {modes : List ModVar}
    {n : Nat} {a : CompareTy} (ha : LatticeForm (basis names modes n).types a) :
    Supports (·∈names) (·∈modes) a := by
  induction ha with
  | atom h => exact types_support names modes n _ h
  | join _ _ ih₁ ih₂ | meet _ _ ih₁ ih₂ => exact ⟨ih₁,ih₂⟩

/-- Shared finite input-supported images exist exactly when one concrete
ranked generator level has a consistent signed observation graph. The graph
contains original relational edges, order edges, and constant-boundary edges.
No fixed semantic quotient or cyclic type witness is accepted by this criterion. -/
theorem supported_iff_ranked_certificate {I : Type*} [Fintype I]
    {Δ : Bounds} (hn : ¬∃ρ, ComparisonShape.Models Δ ρ)
    (names : List TypeVar) (modes : List ModVar)
    (r : Constraints I (Order Δ .unit)) :
    (∃images : I→Carrier Δ .unit,
      (∀i,Supports (·∈names) (·∈modes) (images i).type) ∧
      ∀{a b},r.edge a b → signedValue (fun i => Order.of (images i)) a ≤
        signedValue (fun i => Order.of (images i)) b) ↔
    ∃n,(r.system.quotient (generators hn names modes n)).Consistent := by
  classical
  constructor
  · rintro ⟨images,hs,he⟩
    let n := Finset.univ.sup (fun i => rank (images i).type)
    refine ⟨n,r.consistent_of_generated _ (fun i => Order.of (images i)) ?_ he⟩
    intro i
    exact carrier_generated hn names modes (images i) (hs i)
      (Finset.le_sup (f := fun i => rank (images i).type) (Finset.mem_univ i))
  · rintro ⟨n,hc⟩
    obtain ⟨terms,hg,he⟩ := (r.generated_iff_consistent (generators hn names modes n)).mpr hc
    have hi : ∀i,∃a,LatticeForm (basis names modes n).types a ∧
        ∃hr : Representable Δ .unit a,Order.of (represented hr)=terms i :=
      fun i => generated_lattice hn names modes n (hg i)
    choose types hform hrep hvalue using hi
    let images (i : I) : Carrier Δ .unit := represented (hrep i)
    have hv : (fun i => Order.of (images i))=terms := funext hvalue
    exact ⟨images,fun i => lattice_supported (hform i),hv.symm ▸ he⟩

/-- A successful ranked certificate additionally supplies actual positive CNF
and finite reconstruction for every image under the unchanged common context. -/
theorem certificate_finite_images {I : Type*} [Fintype I]
    {Δ : Bounds} (hn : ¬∃ρ, ComparisonShape.Models Δ ρ)
    (names : List TypeVar) (modes : List ModVar)
    (r : Constraints I (Order Δ .unit)) {n : Nat}
    (hc : (r.system.quotient (generators hn names modes n)).Consistent) :
    ∃images : I→Carrier Δ .unit,
      (∀i,∃clauses,Polynomial (basis names modes n) clauses ∧
        ComparisonPropagation.reify (basis names modes n).types clauses=some (images i).type) ∧
      (∀i,Supports (·∈names) (·∈modes) (images i).type) ∧
      ∀{a b},r.edge a b → signedValue (fun i => Order.of (images i)) a ≤
        signedValue (fun i => Order.of (images i)) b := by
  classical
  obtain ⟨terms,hg,he⟩ := (r.generated_iff_consistent (generators hn names modes n)).mpr hc
  have hi : ∀i,∃a clauses,Polynomial (basis names modes n) clauses ∧
      ComparisonPropagation.reify (basis names modes n).types clauses=some a ∧
      ∃hr : Representable Δ .unit a,Order.of (represented hr)=terms i := by
    intro i
    obtain ⟨a,ha,har,hav⟩ := generated_lattice hn names modes n (hg i)
    obtain ⟨clauses,hcompile⟩ := ComparisonLatticeCompiler.compile_complete ha
    obtain ⟨t,hreify,htr,hte⟩ := ComparisonLatticeCompiler.compile_correct
      (types_representable hn names modes n) hcompile
    exact ⟨t,clauses,(ComparisonLatticeCompiler.compile_polynomial hcompile).2,
      hreify,htr,(show Order.of (represented htr)=Order.of (represented har) from
        Quotient.sound hte).trans hav⟩
  choose types clauses hpoly hreify hrep hvalue using hi
  let images (i : I) : Carrier Δ .unit := represented (hrep i)
  have hv : (fun i => Order.of (images i))=terms := funext hvalue
  refine ⟨images,fun i => ⟨clauses i,hpoly i,hreify i⟩,?_,hv.symm ▸ he⟩
  intro i
  have hf : LatticeForm (basis names modes n).types (types i) :=
    ComparisonPropagation.reify_property (hreify i) _ (fun _ => LatticeForm.atom)
      (fun _ _ => LatticeForm.join) (fun _ _ => LatticeForm.meet)
  exact lattice_supported hf

end ModalityInference.ComparisonRankedBasis
