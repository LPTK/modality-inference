import ModalityInference.Proofs.ComparisonRawCarrierStructural
import ModalityInference.Proofs.ComparisonPartialCarrierRules

/-!
# Obstruction to extending the current carrier interpretation

The actual comparison algebra remains sound in the set model below. The failure
is in extending `ComparisonPartialCarrier.Related.prod` to arbitrary raw ambient
bounds: both interpreted child premises hold, but its interpreted conclusion
does not. In particular, `source_subtype_target` proves the actual product
comparison; `product_obstruction` refutes its proposed carrier interpretation.

Defined types inhabit the level-zero sublattice generated by three atoms. A
total expansive action adds a level-zero atom from each of two level-one markers.
Undefined primitive annotations shift levels, and literal modality composition
is interpreted by composition of these actions. Products are left projection on
defined values, but can emit an additional marker when their other operand is
partial. This marker distinguishes a correlated pair of defined covers from the
separate partial generators retained by the current ideal construction.
-/
namespace ModalityInference.ComparisonRawCarrierCountermodel

abbrev Atom := Nat × Fin 4
abbrev Value := Set Atom

def aa : Atom := (0, 0)
def bb : Atom := (0, 1)
def cc : Atom := (0, 2)
def zz : Atom := (0, 3)
def pp : Atom := (1, 0)
def qq : Atom := (1, 1)
def rr : Atom := (1, 2)

def shift (x : Value) : Value := fun p => ∃ n, p.1 = n + 1 ∧ (n,p.2) ∈ x
def close (x : Value) : Value := x ∪ {p | (p = aa ∧ pp ∈ x) ∨ (p = bb ∧ qq ∈ x)}
def pair (x y : Value) : Value :=
  close x ∪ {p | p = zz ∧ aa ∈ close x ∧ bb ∈ close x ∧ rr ∈ close y}
def Defined (x : Value) : Prop := x ⊆ {aa,bb,cc}

theorem subset_close (x : Value) : x ⊆ close x := Set.subset_union_left

theorem close_mono : Monotone close := by
  intro x y h p hp
  exact hp.elim (fun hp => .inl (h hp)) (fun hp => .inr (hp.elim
    (fun hp => .inl ⟨hp.1,h hp.2⟩) (fun hp => .inr ⟨hp.1,h hp.2⟩)))

theorem close_idem (x : Value) : close (close x) = close x := by
  ext p
  simp [close, aa,bb,pp,qq,or_left_comm,or_comm]


theorem shift_mono : Monotone shift := by
  intro x y h p hp
  obtain ⟨n,hn,hx⟩ := hp
  exact ⟨n,hn,h hx⟩

theorem shift_reflect {x y : Value} : shift x ⊆ shift y ↔ x ⊆ y := by
  constructor
  · intro h p hp
    have hh := h (show (p.1+1,p.2) ∈ shift x from ⟨p.1,rfl,hp⟩)
    change ∃ n, p.1+1 = n+1 ∧ (n,p.2) ∈ y at hh
    simpa using hh
  · exact fun h => shift_mono h

theorem close_shift_reflect {x y : Value} : close (shift x) ⊆ close (shift y) ↔ x ⊆ y := by
  constructor
  · intro h p hp
    have hh := h (show (p.1+1,p.2) ∈ close (shift x) from .inl ⟨p.1,rfl,hp⟩)
    have hh' : (p.1+1,p.2) ∈ shift y := by simpa [close,aa,bb] using hh
    change ∃ n, p.1+1 = n+1 ∧ (n,p.2) ∈ y at hh'
    simpa using hh'
  · exact fun h => close_mono (shift_mono h)


theorem pair_mono {a b c d : Value} (hac : a ⊆ c) (hbd : b ⊆ d) : pair a b ⊆ pair c d := by
  intro p hp
  exact hp.elim (fun hp => .inl (close_mono hac hp)) (fun hp => .inr
    ⟨hp.1,close_mono hac hp.2.1,close_mono hac hp.2.2.1,close_mono hbd hp.2.2.2⟩)

theorem pair_closed (x y : Value) : close (pair x y) = pair x y := by
  apply Set.Subset.antisymm ?_ (subset_close _)
  intro p hp
  rcases hp with hp | hp
  · exact hp
  rcases hp with ⟨rfl,hp⟩ | ⟨rfl,hp⟩
  · have hx : pp ∈ x := by simpa [pair,close,pp,qq,aa,bb,zz] using hp
    exact .inl (.inr (.inl ⟨rfl,hx⟩))
  · have hx : qq ∈ x := by simpa [pair,close,pp,qq,aa,bb,zz] using hp
    exact .inl (.inr (.inr ⟨rfl,hx⟩))

theorem pair_close (x y : Value) : pair (close x) (close y) = pair x y := by
  simp only [pair,close_idem]

inductive Step where
  | close | shift
  deriving DecidableEq

def run : List Step → Value → Value
  | [], x => x
  | .close :: rest, x => close (run rest x)
  | .shift :: rest, x => shift (run rest x)

def kernel : List Step → Bool
  | [] => false
  | [.close] => true
  | [_] => false
  | _ :: next :: rest => kernel (next :: rest)

def base (b : Bool) (x : Value) : Value := if b then close x else x

theorem run_kernel (steps : List Step) (x y : Value) :
    run steps x ⊆ run steps y ↔ base (kernel steps) x ⊆ base (kernel steps) y := by
  induction steps with
  | nil => rfl
  | cons step rest ih =>
    cases step with
    | shift =>
      cases rest with
      | nil => exact shift_reflect
      | cons head tail => exact shift_reflect.trans ih
    | close =>
      cases rest with
      | nil => rfl
      | cons head tail =>
        cases head with
        | close => simpa only [run,close_idem,kernel] using ih
        | shift => simpa only [run,close_shift_reflect,shift_reflect,kernel] using ih


theorem run_append (as bs : List Step) (x : Value) : run (as ++ bs) x = run as (run bs x) := by
  induction as with
  | nil => rfl
  | cons a as ih => cases a <;> simp only [List.cons_append,run,ih]

theorem run_mono (steps : List Step) : Monotone (run steps) := by
  intro x y h
  apply (run_kernel steps x y).mpr
  cases hk : kernel steps <;> simp only [base,Bool.false_eq_true,if_false,if_true]
  · exact h
  · exact close_mono h

theorem run_pair (steps : List Step) {a b c d : Value}
    (hac : run steps a ⊆ run steps c) (hbd : run steps b ⊆ run steps d) :
    run steps (pair a b) ⊆ run steps (pair c d) := by
  have ha := (run_kernel steps a c).mp hac
  have hb := (run_kernel steps b d).mp hbd
  apply (run_kernel steps _ _).mpr
  cases hk : kernel steps <;> simp only [base,hk,Bool.false_eq_true,if_false,if_true] at ha hb ⊢
  · exact pair_mono ha hb
  · simpa only [pair_closed,pair_close] using pair_mono ha hb

def assignment : ModVar → Mode := fun _ => Mode.identity

def concrete (m : Mode) : List Step := if m.unique then [] else [.close]

def word : ModExpr → List Step
  | .compose a b => word b ++ word a
  | m => match m.eval (some ∘ assignment) with
    | some n => concrete n
    | none => [.shift]

def act (m : ModExpr) (x : Value) : Value := run (word m) x

theorem concrete_run (m : Mode) (x : Value) : run (concrete m) x = base (!m.unique) x := by
  cases h : m.unique <;> simp [concrete,h,run,base]

theorem concrete_compose (a b : Mode) (x : Value) :
    run (concrete (a.compose b)) x = run (concrete b) (run (concrete a) x) := by
  cases ha : a.unique <;> cases hb : b.unique <;>
    simp [concrete,Mode.compose,ha,hb,run,close_idem]

theorem act_of_eval {m : ModExpr} {n : Mode}
    (h : m.eval (some ∘ assignment) = some n) (x : Value) : act m x = run (concrete n) x := by
  induction m generalizing n x with
  | compose a b iha ihb =>
    obtain ⟨u,hu,v,hv,rfl⟩ : ∃ u, a.eval (some ∘ assignment) = some u ∧
        ∃ v, b.eval (some ∘ assignment) = some v ∧ u.compose v = n := by
      simpa [ModExpr.eval,Option.bind_eq_some_iff] using h
    exact (run_append _ _ x).trans ((congrArg (run (word b)) (iha hu x)).trans
      ((ihb hv _).trans (concrete_compose u v x).symm))
  | const | var | meet | join | leftResidual | rightResidual | close | closeInv | future | capture =>
    simp only [act,word,h]


theorem defined_positive {x : Value} (hx : Defined x) (n : Nat) (k : Fin 4) : (n+1,k) ∉ x := by
  intro hp
  have h := hx hp
  simp [aa,bb,cc] at h

theorem close_defined {x : Value} (hx : Defined x) : close x = x := by
  simp only [close,show pp ∉ x from defined_positive hx 0 0,
    show qq ∉ x from defined_positive hx 0 1,and_false,or_self,Set.setOf_false,Set.union_empty]

theorem pair_defined {x y : Value} (hx : Defined x) (hy : Defined y) : pair x y = x := by
  simp only [pair,close_defined hx,close_defined hy,
    show rr ∉ y from defined_positive hy 0 2,and_false,Set.setOf_false,Set.union_empty]

theorem act_defined {Δ : Bounds} (hη : ModeModels Δ assignment)
    {m : ModExpr} (hm : Entails Δ (.defined m)) {x : Value} (hx : Defined x) : act m x = x := by
  obtain ⟨n,hn⟩ := Option.isSome_iff_exists.mp (hm assignment hη)
  rw [act_of_eval hn,concrete_run]
  cases h : n.unique <;> simp [base,close_defined hx]

def interpret : CompareTy → Value
  | .var (.rigid 0) => {aa}
  | .var (.rigid 1) => {bb}
  | .var _ => {cc}
  | .unit | .credit => ∅
  | .prod a b | .sum a b => pair (interpret a) (interpret b)
  | .fn _ _ => ∅
  | .modal a m => act m (interpret a)
  | .join a b => interpret a ∪ interpret b
  | .meet a b => interpret a ∩ interpret b

theorem interpret_defined {Δ : Bounds} (hη : ModeModels Δ assignment)
    {a : CompareTy} (ha : a.DefinedUnder Δ) : Defined (interpret a) := by
  induction a with
  | var v => cases v with
    | flex => simp [Defined,interpret]
    | rigid n => cases n with
      | zero => simp [Defined,interpret]
      | succ n => cases n <;> simp [Defined,interpret]
  | unit | credit | fn => exact Set.empty_subset _
  | prod a b iha ihb =>
    have h := CompareTy.definedUnder_prod_iff.mp ha
    simpa only [interpret,pair_defined (iha h.1) (ihb h.2)] using iha h.1
  | sum a b iha ihb =>
    have h := CompareTy.definedUnder_sum_iff.mp ha
    simpa only [interpret,pair_defined (iha h.1) (ihb h.2)] using iha h.1
  | modal a m ih =>
    have h := CompareTy.definedUnder_modal_iff.mp ha
    simpa only [interpret,act_defined hη h.2 (ih h.1)] using ih h.1
  | join a b iha ihb =>
    exact Set.union_subset (iha (CompareTy.definedUnder_join_iff.mp ha).1)
      (ihb (CompareTy.definedUnder_join_iff.mp ha).2)
  | meet a b iha _ =>
    exact Set.Subset.trans Set.inter_subset_left (iha (CompareTy.definedUnder_meet_iff.mp ha).1)


def erase : CompareTy → Value
  | .var v => interpret (.var v)
  | .unit | .credit | .fn _ _ => ∅
  | .prod a _ | .sum a _ | .modal a _ => erase a
  | .join a b => erase a ∪ erase b
  | .meet a b => erase a ∩ erase b

theorem interpret_defined_eq {Δ : Bounds} (hη : ModeModels Δ assignment)
    {a : CompareTy} (ha : a.DefinedUnder Δ) : interpret a = erase a := by
  induction a with
  | var | unit | credit | fn => rfl
  | prod a b iha _ =>
    have h := CompareTy.definedUnder_prod_iff.mp ha
    exact (pair_defined (interpret_defined hη h.1) (interpret_defined hη h.2)).trans (iha h.1)
  | sum a b iha _ =>
    have h := CompareTy.definedUnder_sum_iff.mp ha
    exact (pair_defined (interpret_defined hη h.1) (interpret_defined hη h.2)).trans (iha h.1)
  | modal a m ih =>
    have h := CompareTy.definedUnder_modal_iff.mp ha
    exact (act_defined hη h.2 (interpret_defined hη h.1)).trans (ih h.1)
  | join a b iha ihb =>
    exact congrArg₂ Union.union (iha (CompareTy.definedUnder_join_iff.mp ha).1)
      (ihb (CompareTy.definedUnder_join_iff.mp ha).2)
  | meet a b iha ihb =>
    exact congrArg₂ Inter.inter (iha (CompareTy.definedUnder_meet_iff.mp ha).1)
      (ihb (CompareTy.definedUnder_meet_iff.mp ha).2)

theorem equation_sound {Δ : Bounds} (hη : ModeModels Δ assignment)
    {a b : CompareTy} (h : ComparisonAlgebra.Equation Δ a b) : interpret a = interpret b := by
  have hd := ComparisonDefinedCovers.equation_defined h
  rw [interpret_defined_eq hη hd.1,interpret_defined_eq hη hd.2]
  cases h with
  | distrib p _ _ =>
    cases p
    · exact Set.inter_union_distrib_left _ _ _
    · exact Set.union_inter_distrib_left _ _ _
  | modal p _ _ => cases p <;> simp [erase,ComparisonAlgebra.typeOp]
  | scalar p _ _ _ _ => cases p <;> simp [erase,ComparisonAlgebra.typeOp]
  | prod p _ _ => cases p <;> simp [erase,ComparisonAlgebra.typeOp]
  | sum p _ _ => cases p <;> simp [erase,ComparisonAlgebra.typeOp]
  | fn p _ _ => cases p <;> simp [erase,ComparisonAlgebra.typeOp]

theorem shift_empty : shift ∅ = ∅ := by
  ext p
  change (∃ n, p.1 = n+1 ∧ False) ↔ False
  simp

theorem act_empty (m : ModExpr) : act m ∅ = ∅ := by
  have h : ∀ steps, run steps ∅ = ∅ := by
    intro steps
    induction steps with
    | nil => rfl
    | cons s ss ih => cases s <;> simp [run,ih,close,shift_empty]
  exact h _

theorem act_submode {Δ : Bounds} (hη : ModeModels Δ assignment)
    {m n : ModExpr} {x y : Value} (hmn : Submode Δ m n) (hxy : x ⊆ y) : act m x ⊆ act n y := by
  obtain ⟨a,b,ha,hb,hab⟩ := hmn.denote hη
  rw [act_of_eval ha,act_of_eval hb,concrete_run,concrete_run]
  cases hau : a.unique <;> cases hbu : b.unique <;>
    simp only [Bool.not_false,Bool.not_true,base,Bool.false_eq_true,if_false,if_true]
  · exact close_mono hxy
  · simp [Mode.le,hau,hbu] at hab
  · exact hxy.trans (subset_close _)
  · exact hxy


theorem shaped_sound {Δ : Bounds} (hη : ModeModels Δ assignment)
    (hΔ : ∀ a b, Constraint.sub a b ∈ Δ → interpret (.ofTy a) ⊆ interpret (.ofTy b))
    {a b : CompareTy} (h : ShapedSubtype Δ a b) : interpret a ⊆ interpret b := by
  induction h with
  | refl => exact Set.Subset.refl _
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂
  | bound hb => exact hΔ _ _ hb
  | identity | identityRev => exact Set.Subset.refl _
  | compose | composeRev =>
    simp only [interpret,act,word,run_append]
    exact Set.Subset.refl _
  | congr _ hmn ih => exact act_submode hη hmn ih
  | prod _ _ iha ihb | sum _ _ iha ihb => exact run_pair _ iha ihb
  | fn => simp only [interpret,act_empty]; exact Set.Subset.refl _
  | joinLeft => exact Set.subset_union_left
  | joinRight => exact Set.subset_union_right
  | joinLeast _ _ iha ihb => exact Set.union_subset iha ihb
  | meetLeft => exact Set.inter_subset_left
  | meetRight => exact Set.inter_subset_right
  | meetGreatest _ _ iha ihb => exact Set.subset_inter iha ihb

theorem clamp_eq {Δ : Bounds} (hη : ModeModels Δ assignment)
    {a b t : CompareTy} {m : ModExpr}
    (ha : a.DefinedUnder Δ) (hb : b.DefinedUnder Δ) (ht : t.DefinedUnder Δ)
    (hm : Entails Δ (.defined m))
    (hba : interpret b ⊆ interpret a) (hat : interpret a ⊆ interpret t) :
    interpret (.modal a m) = interpret (.meet (.join a (.modal b m)) (.modal t m)) := by
  simp only [interpret,act_defined hη hm (interpret_defined hη ha),
    act_defined hη hm (interpret_defined hη hb),act_defined hη hm (interpret_defined hη ht)]
  rw [Set.union_eq_self_of_subset_right hba,Set.inter_eq_left.mpr hat]

theorem algebra_sound {Δ : Bounds} (hη : ModeModels Δ assignment)
    (hΔ : ∀ a b, Constraint.sub a b ∈ Δ → interpret (.ofTy a) ⊆ interpret (.ofTy b))
    {a b : CompareTy} (h : AlgebraSubtype Δ a b) : interpret a ⊆ interpret b := by
  induction h with
  | shaped h => exact shaped_sound hη hΔ h
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂
  | equation h => rw [equation_sound hη h]
  | equationRev h => rw [equation_sound hη h]
  | congr _ hmn ih => exact act_submode hη hmn ih
  | prod _ _ iha ihb | sum _ _ iha ihb => exact run_pair _ iha ihb
  | fn => simp only [interpret,act_empty]; exact Set.Subset.refl _
  | joinLeast _ _ iha ihb => exact Set.union_subset iha ihb
  | meetGreatest _ _ iha ihb => exact Set.subset_inter iha ihb
  | clamp hab hat hm _ _ ihba ihat =>
    rw [clamp_eq hη hab.2.2 hab.2.1 hat.2.2 hm ihba ihat]
  | clampRev hab hat hm _ _ ihba ihat =>
    rw [clamp_eq hη hab.2.2 hab.2.1 hat.2.2 hm ihba ihat]


def bad : ModExpr := .leftResidual .epsilon .bottom

def leafA : Ty := .var (.rigid 0)
def leafB : Ty := .var (.rigid 1)
def leafC : Ty := .var (.rigid 2)
def partialA : CompareTy := .modal (.ofTy leafA) bad
def partialB : CompareTy := .modal (.ofTy leafB) bad
def partialC : CompareTy := .modal (.ofTy leafC) bad
def joined : CompareTy := .join (.ofTy leafA) (.ofTy leafB)
def partialJoined : CompareTy := .join partialA partialB

def bounds : Bounds :=
  [.sub (.modal leafA .top) (.modal (.modal leafA bad) .top),
   .sub (.modal leafB .top) (.modal (.modal leafB bad) .top),
   .sub (.fn leafA .unit) (.fn leafB .unit)]

def source : CompareTy := .modal (.prod joined partialC) .top
def target : CompareTy := .modal (.prod partialJoined partialC) .top

theorem scalar_model : ModeModels bounds assignment := by
  simp [ModeModels,bounds,ModeSatisfies]

theorem act_top (x : Value) : act .top x = close x := rfl

theorem act_bad (x : Value) : act bad x = shift x := rfl

theorem shift_singleton (n : Nat) (k : Fin 4) : shift {(n,k)} = {(n+1,k)} := by
  ext p
  change (∃ m, p.1 = m+1 ∧ (m,p.2) = (n,k)) ↔ p = (n+1,k)
  simp [Prod.ext_iff]

theorem interpret_partialA : interpret partialA = {pp} := shift_singleton 0 0
theorem interpret_partialB : interpret partialB = {qq} := shift_singleton 0 1
theorem interpret_partialC : interpret partialC = {rr} := shift_singleton 0 2

theorem bounds_sound : ∀ a b, Constraint.sub a b ∈ bounds →
    interpret (.ofTy a) ⊆ interpret (.ofTy b) := by
  intro a b h
  simp only [bounds,List.mem_cons,List.not_mem_nil,or_false,Constraint.sub.injEq] at h
  rcases h with ⟨rfl,rfl⟩ | ⟨rfl,rfl⟩ | h
  · change close {aa} ⊆ close (interpret partialA)
    rw [interpret_partialA]
    simp [close,aa,bb,pp,qq]
  · change close {bb} ⊆ close (interpret partialB)
    rw [interpret_partialB]
    simp [close,aa,bb,pp,qq]
  · obtain ⟨rfl,rfl⟩ := h
    exact Set.Subset.refl _

theorem sound {a b : CompareTy} (h : AlgebraSubtype bounds a b) : interpret a ⊆ interpret b :=
  algebra_sound scalar_model bounds_sound h


open ComparisonPartialCarrier

theorem defined_subset_positive {x : Value} (hx : Defined x) (n : Nat) (k : Fin 4)
    (h : x ⊆ {(n+1,k)}) : x = ∅ := by
  apply Set.eq_empty_iff_forall_notMem.mpr
  intro p hp
  have he : p = (n+1,k) := h hp
  exact defined_positive hx n k (he ▸ hp)

theorem lower_partialJoined {u : CompareTy}
    (h : (denote bounds partialJoined).lower.mem u) :
    interpret u ⊆ {pp} ∨ interpret u ⊆ {qq} := by
  change LowerClosure bounds (fun t => (denote bounds partialA).lower.mem t ∨
    (denote bounds partialB).lower.mem t) u at h
  induction h with
  | base _ _ h =>
    rcases h with h | h
    · exact .inl (by simpa only [interpret_partialA] using
        (sound ((denote_sound (a := partialA) True.intro).1 _ h)))
    · exact .inr (by simpa only [interpret_partialB] using
        (sound ((denote_sound (a := partialB) True.intro).1 _ h)))
  | lower _ hab _ ih =>
    exact ih.elim
      (fun h => .inl ((sound hab).trans h)) (fun h => .inr ((sound hab).trans h))
  | @join a b hc _ _ iha ihb =>
    have ha : interpret a = ∅ := iha.elim
      (defined_subset_positive (interpret_defined scalar_model hc.2.1) 0 0)
      (defined_subset_positive (interpret_defined scalar_model hc.2.1) 0 1)
    have hb : interpret b = ∅ := ihb.elim
      (defined_subset_positive (interpret_defined scalar_model hc.2.2) 0 0)
      (defined_subset_positive (interpret_defined scalar_model hc.2.2) 0 1)
    exact .inl (by simp only [interpret,ha,hb,Set.union_self]; exact Set.empty_subset _)

theorem pair_no_marker {u v : Value} (hu : u ⊆ {pp} ∨ u ⊆ {qq}) : zz ∉ pair u v := by
  rcases hu with hu | hu
  · intro hz
    have h := pair_mono hu (Set.Subset.refl v) hz
    simp [pair,close,aa,bb,pp,qq,zz] at h
  · intro hz
    have h := pair_mono hu (Set.Subset.refl v) hz
    simp [pair,close,aa,bb,pp,qq,zz] at h

theorem lower_no_marker {S : CompareTy → Prop}
    (hS : ∀ u, S u → zz ∉ interpret u) {u : CompareTy}
    (h : LowerClosure bounds S u) : zz ∉ interpret u := by
  induction h with
  | base _ _ h => exact hS _ h
  | lower _ hab _ ih => exact fun hz => ih (sound hab hz)
  | join _ _ _ iha ihb => exact fun hz => hz.elim iha ihb

theorem target_no_marker {u : CompareTy} (h : (denote bounds target).lower.mem u) :
    zz ∉ interpret u := by
  have hm : Entails bounds (.defined .top) := fun _ _ => rfl
  change (denote bounds (.modal (.prod partialJoined partialC) .top)).lower.mem u at h
  simp only [denote,if_pos hm] at h
  apply lower_no_marker ?_ h
  rintro _ ⟨v,hv,rfl⟩
  have hvz : zz ∉ interpret v := by
    apply lower_no_marker ?_ hv
    rintro _ ⟨a,b,ha,_,rfl⟩
    exact pair_no_marker (lower_partialJoined ha)
  simpa only [interpret,act_top,close,Set.mem_union,Set.mem_setOf_eq,
    show zz ≠ aa from by decide,show zz ≠ bb from by decide,false_and,or_false] using hvz

theorem source_marker : zz ∈ interpret source := by
  change zz ∈ close (pair (interpret joined) (interpret partialC))
  rw [interpret_partialC]
  simp [joined,leafA,leafB,CompareTy.ofTy,interpret,pair,close,aa,bb,pp,qq,rr,zz]

theorem source_not_target_lower : ¬ (denote bounds target).lower.mem source :=
  fun h => target_no_marker h source_marker


theorem top_defined : Entails bounds (.defined .top) := fun _ _ => rfl

theorem var_defined (v : TypeVar) : (CompareTy.var v).DefinedUnder bounds := by
  simp [CompareTy.DefinedUnder,CompareTy.wellFormedBounds,ModeModels]

theorem joined_shaped : joined.WellShaped bounds := by
  refine ⟨True.intro,True.intro,?_⟩
  intro ρ hρ
  have h := hρ (.fn (.var (.rigid 0)) .unit,.fn (.var (.rigid 1)) .unit)
    (by simp [ComparisonShape.pairs,bounds,leafA,leafB,ComparisonShape.ofTy])
  exact (ComparisonShape.fn.inj h).1

theorem partialJoined_shaped : partialJoined.WellShaped bounds := joined_shaped

theorem joined_compatible : ComparisonAlgebra.Compatible bounds (.ofTy leafA) (.ofTy leafB) :=
  ⟨joined_shaped,var_defined _,var_defined _⟩

theorem boundA : AlgebraSubtype bounds (.modal (.ofTy leafA) .top) (.modal partialA .top) :=
  .shaped (.bound (a := .modal leafA .top) (b := .modal (.modal leafA bad) .top)
    (by simp [bounds]))

theorem boundB : AlgebraSubtype bounds (.modal (.ofTy leafB) .top) (.modal partialB .top) :=
  .shaped (.bound (a := .modal leafB .top) (b := .modal (.modal leafB bad) .top)
    (by simp [bounds]))

theorem left_algebra : AlgebraSubtype bounds (.modal joined .top) (.modal partialJoined .top) :=
  (AlgebraSubtype.equation (.modal true joined_compatible top_defined)).trans
    (.joinLeast (boundA.trans (.congr (.shaped (.joinLeft partialJoined_shaped)) (.refl top_defined)))
      (boundB.trans (.congr (.shaped (.joinRight partialJoined_shaped)) (.refl top_defined))))

theorem left_related : Related bounds (.modal joined .top) (.modal partialJoined .top) := by
  have ha := var_defined (.rigid 0)
  have hb := var_defined (.rigid 1)
  have ra : Related bounds (.modal (.ofTy leafA) .top) (.modal partialA .top) :=
    Related.carriers True.intro True.intro boundA
  have rb : Related bounds (.modal (.ofTy leafB) .top) (.modal partialB .top) :=
    Related.carriers True.intro True.intro boundB
  exact (Related.carriers (show Carrier bounds (.modal joined .top) from ⟨ha,hb⟩)
    (show Carrier bounds (.join (.modal (.ofTy leafA) .top) (.modal (.ofTy leafB) .top)) from
      ⟨CompareTy.definedUnder_modal_iff.mpr ⟨ha,top_defined⟩,
       CompareTy.definedUnder_modal_iff.mpr ⟨hb,top_defined⟩⟩)
    (.equation (.modal true joined_compatible top_defined))).trans
      (Related.joinLeast (ra.trans (Related.congr (Related.joinLeft partialA partialB) (.refl top_defined)))
        (rb.trans (Related.congr (Related.joinRight partialA partialB) (.refl top_defined))))

theorem source_carrier : Carrier bounds source := ⟨⟨var_defined _,var_defined _⟩,True.intro⟩
theorem source_shaped : source.WellShaped bounds := ⟨joined_shaped,True.intro⟩

theorem source_subtype_target : AlgebraSubtype bounds source target :=
  .prod left_algebra (.refl True.intro)

/-- The current carrier interpretation does not validate the product rule under
arbitrary mixed defined/partial declared edges. Both child premises hold in the
syntax and in the interpretation, whereas the conclusion fails. -/
theorem product_obstruction :
    AlgebraSubtype bounds (.modal joined .top) (.modal partialJoined .top) ∧
    AlgebraSubtype bounds (.modal partialC .top) (.modal partialC .top) ∧
    Related bounds (.modal joined .top) (.modal partialJoined .top) ∧
    Related bounds (.modal partialC .top) (.modal partialC .top) ∧
    ¬Related bounds source target :=
  ⟨left_algebra,.refl True.intro,left_related,Related.refl _,
    fun h => source_not_target_lower (h.1 _ (denote_self source_carrier source_shaped).1)⟩


/-- Therefore the omitted whole-context guard cannot simply be removed from the
existing carrier product theorem. -/
theorem no_general_product_rule : ¬ (∀ (Δ : Bounds) (a b c d : CompareTy) (m : ModExpr),
    AlgebraSubtype Δ (.modal a m) (.modal c m) →
    AlgebraSubtype Δ (.modal b m) (.modal d m) →
    Related Δ (.modal a m) (.modal c m) →
    Related Δ (.modal b m) (.modal d m) →
    Related Δ (.modal (.prod a b) m) (.modal (.prod c d) m)) := by
  intro h
  exact product_obstruction.2.2.2.2 (h bounds joined partialC partialJoined partialC .top
    left_algebra (.refl True.intro) left_related (Related.refl _))

end ModalityInference.ComparisonRawCarrierCountermodel
