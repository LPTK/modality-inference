import ModalityInference.Proofs.ComparisonObserverChains

/-! Finite signed graph models reconstruct terms generated by the actual finite
observation basis. This records the finite-term provenance needed by ranked
constructor grammars. -/
namespace ModalityInference.ComparisonObserverChains

theorem finite_reify_property {L : Type*} [Lattice L] (p : Finset L)
    (v : LatticeHom L Bool → Bool)
    (mono : ∀f g,(∀a ∈ p,f a ≤ g a) → v f ≤ v g)
    (zero : v (constant false) = false) (one : v (constant true) = true)
    (P : L → Prop) (hp : ∀a∈p,P a)
    (hjoin : ∀a b,P a→P b→P (a⊔b)) (hmeet : ∀a b,P a→P b→P (a⊓b)) :
    ∃t : L,P t ∧ ∀f,f t = v f := by
  classical
  let positives : Finset (p → Bool) := Finset.univ.filter
    (fun w => ∃f : LatticeHom L Bool,(∀a : p,f a.val = w a) ∧ v f = true)
  have hpos : positives.Nonempty := by
    refine ⟨fun _ => true,Finset.mem_filter.mpr ⟨Finset.mem_univ _,?_⟩⟩
    exact ⟨constant true,fun _ => rfl,one⟩
  let inputs (w : p → Bool) : Finset p := Finset.univ.filter (fun a => w a = true)
  have hn (w : p → Bool) (hw : w ∈ positives) : (inputs w).Nonempty := by
    obtain ⟨f,hf,hv⟩ := (Finset.mem_filter.mp hw).2
    by_contra he
    have hle := mono f (constant false) (by
      intro a ha
      rw [hf ⟨a,ha⟩]
      cases hwa : w ⟨a,ha⟩ with
      | false => exact Bool.false_le _
      | true => exact False.elim (he ⟨⟨a,ha⟩,Finset.mem_filter.mpr ⟨Finset.mem_univ _,hwa⟩⟩))
    rw [hv,zero] at hle
    exact (by decide : ¬(true : Bool) ≤ false) hle
  let meet (w : positives) : L := (inputs w.val).inf' (hn w.val w.property) Subtype.val
  have hm (w : positives) (f : LatticeHom L Bool) :
      f (meet w) = true ↔ ∀a : p,w.val a = true → f a.val = true := by
    constructor
    · intro hf a ha
      have hle := OrderHomClass.monotone f (Finset.inf'_le Subtype.val
        (Finset.mem_filter.mpr ⟨Finset.mem_univ a,ha⟩ : a ∈ inputs w.val))
      change f (meet w) ≤ f a.val at hle
      rw [hf] at hle
      exact Bool.eq_true_of_true_le hle
    · intro hf
      change f ((inputs w.val).inf' (hn w.val w.property) Subtype.val) = true
      rw [map_finset_inf']
      apply Bool.eq_true_of_true_le
      apply Finset.le_inf'
      intro a ha
      rw [show (f ∘ Subtype.val) a = true from hf a (Finset.mem_filter.mp ha).2]
  let t : L := positives.attach.sup' hpos.attach meet
  refine ⟨t,?_,?_⟩
  · apply Finset.sup'_induction
    · exact fun a ha b hb => hjoin a b ha hb
    · intro w _
      apply Finset.inf'_induction
      · exact fun a ha b hb => hmeet a b ha hb
      · intro a _
        exact hp a.val a.property
  intro f
  apply le_antisymm
  · change f (positives.attach.sup' hpos.attach meet) ≤ v f
    rw [map_finset_sup']
    apply Finset.sup'_le
    intro w _
    apply Bool.le_iff_imp.mpr
    intro hmeet
    obtain ⟨g,hg,hv⟩ := (Finset.mem_filter.mp w.property).2
    apply Bool.le_iff_imp.mp (mono g f ?_) hv
    intro a ha
    apply Bool.le_iff_imp.mpr
    intro hga
    exact (hm w f).mp hmeet ⟨a,ha⟩ ((hg ⟨a,ha⟩).symm.trans hga)
  · apply Bool.le_iff_imp.mpr
    intro hv
    let w : p → Bool := fun a => f a.val
    have hw : w ∈ positives :=
      Finset.mem_filter.mpr ⟨Finset.mem_univ _,f,fun _ => rfl,hv⟩
    have hmeet : f (meet ⟨w,hw⟩) = true := (hm _ f).mpr (fun _ ha => ha)
    have hle := OrderHomClass.monotone f (Finset.le_sup' meet
      (Finset.mem_attach positives ⟨w,hw⟩))
    change f (meet ⟨w,hw⟩) ≤ f t at hle
    rw [hmeet] at hle
    exact Bool.eq_true_of_true_le hle

theorem Constraints.finite_model_reify_property {I L} [Lattice L] (r : Constraints I L)
    (p : Finset L) {model : Bool × I × (p → Bool) → Bool}
    (hm : (r.system.quotient p).Model model)
    (P : L → Prop) (hp : ∀a∈p,P a)
    (hjoin : ∀a b,P a→P b→P (a⊔b)) (hmeet : ∀a b,P a→P b→P (a⊓b)) :
    ∃terms : I→L,(∀i,P (terms i)) ∧
      ∀{a b},r.edge a b → signedValue terms a ≤ signedValue terms b := by
  classical
  have hi (i : I) : ∃t : L,P t ∧ ∀f,f t = model (observe p (true,i,f)) := by
    apply finite_reify_property p _ ?_ ?_ ?_ P hp hjoin hmeet
    · intro f g hfg
      exact hm.edge ⟨(true,i,f),(true,i,g),rfl,rfl,.positive i f g hfg⟩
    · have hle := hm.edge ⟨(true,i,constant false),(false,i,constant false),
        rfl,rfl,Constraints.Edge.boundary (r := r) (p := p) i false⟩
      have hneg := hm.complement (observe p (true,i,constant false))
      change model (observe p (false,i,constant false)) =
        !model (observe p (true,i,constant false)) at hneg
      rw [hneg] at hle
      cases hv : model (observe p (true,i,constant false)) <;> simp_all [Bool.le_iff_imp]
    · have hle := hm.edge ⟨(false,i,constant true),(true,i,constant true),
        rfl,rfl,Constraints.Edge.boundary (r := r) (p := p) i true⟩
      have hneg := hm.complement (observe p (true,i,constant true))
      change model (observe p (false,i,constant true)) =
        !model (observe p (true,i,constant true)) at hneg
      rw [hneg] at hle
      cases hv : model (observe p (true,i,constant true)) <;> simp_all [Bool.le_iff_imp]
  choose terms ht using hi
  have he (a : Point I L) : signedValue terms a = model (observe p a) := by
    obtain ⟨b,i,f⟩ := a
    cases b with
    | true => exact (ht i).2 f
    | false =>
      have hneg := hm.complement (observe p (true,i,f))
      change model (observe p (false,i,f)) = !model (observe p (true,i,f)) at hneg
      exact (congrArg Bool.not ((ht i).2 f)).trans hneg.symm
  refine ⟨terms,fun i => (ht i).1,?_⟩
  intro a b hab
  rw [he a,he b]
  exact hm.edge ⟨a,b,rfl,rfl,.original hab⟩

inductive LatticeGenerated {L : Type*} [Lattice L] (p : Finset L) : L → Prop
  | atom {a} : a∈p → LatticeGenerated p a
  | sup {a b} : LatticeGenerated p a → LatticeGenerated p b → LatticeGenerated p (a⊔b)
  | inf {a b} : LatticeGenerated p a → LatticeGenerated p b → LatticeGenerated p (a⊓b)

theorem LatticeGenerated.observer_mono {L : Type*} [Lattice L]
    {p : Finset L} {a : L} (ha : LatticeGenerated p a) (f g : LatticeHom L Bool)
    (h : ∀x∈p,f x≤g x) : f a≤g a := by
  induction ha with
  | atom ha => exact h _ ha
  | sup _ _ ih₁ ih₂ => simpa only [map_sup] using sup_le_sup ih₁ ih₂
  | inf _ _ ih₁ ih₂ => simpa only [map_inf] using inf_le_inf ih₁ ih₂

theorem LatticeGenerated.observer_eq {L : Type*} [Lattice L]
    {p : Finset L} {a : L} (ha : LatticeGenerated p a) (f g : LatticeHom L Bool)
    (h : ∀x∈p,f x=g x) : f a=g a :=
  le_antisymm (ha.observer_mono f g (fun x hx => le_of_eq (h x hx)))
    (ha.observer_mono g f (fun x hx => le_of_eq (h x hx).symm))

theorem Constraints.consistent_of_generated {I L} [Lattice L]
    (r : Constraints I L) (p : Finset L) (terms : I→L)
    (hg : ∀i,LatticeGenerated p (terms i))
    (ht : ∀{a b},r.edge a b → signedValue terms a ≤ signedValue terms b) :
    (r.system.quotient p).Consistent := by
  classical
  let value (i : I) (w : p→Bool) : Bool :=
    if h : ∃f : LatticeHom L Bool,∀x:p,f x.val=w x
    then (Classical.choose h) (terms i) else false
  have hv (i : I) (f : LatticeHom L Bool) :
      value i (fun x:p => f x.val) = f (terms i) := by
    have h : ∃g : LatticeHom L Bool,∀x:p,g x.val=f x.val := ⟨f,fun _ => rfl⟩
    simp only [value,dif_pos h]
    exact (hg i).observer_eq _ f (fun x hx => Classical.choose_spec h ⟨x,hx⟩)
  let model (a : Bool × I × (p→Bool)) : Bool :=
    if a.1 then value a.2.1 a.2.2 else !(value a.2.1 a.2.2)
  have he (a : Point I L) : model (observe p a)=signedValue terms a := by
    obtain ⟨sign,i,f⟩ := a
    cases sign <;> simp only [model,observe,signedValue,hv,Bool.false_eq_true,if_false,if_true]
  have hm : (r.system.quotient p).Model model := by
    constructor
    · rintro ⟨sign,i,w⟩
      cases sign <;> simp [model,System.quotient]
    · rintro _ _ ⟨a,b,rfl,rfl,hab⟩
      rw [he a,he b]
      cases hab with
      | original h => exact ht h
      | positive i f g h => exact (hg i).observer_mono f g h
      | negative i f g h =>
        have hh := (hg i).observer_mono g f h
        change (!(f (terms i)))≤(!(g (terms i)))
        cases hf : f (terms i) <;> cases hgv : g (terms i) <;>
          simp_all [Bool.le_iff_imp]
      | boundary i b => cases b <;> simp [signedValue,constant]
  exact hm.consistent

/-- Consistency of one finite observation graph characterizes terms generated
by precisely that finite basis, not arbitrary infinite observer assignments. -/
theorem Constraints.generated_iff_consistent {I L} [Fintype I] [Lattice L]
    (r : Constraints I L) (p : Finset L) :
    (∃terms : I→L,(∀i,LatticeGenerated p (terms i)) ∧
      ∀{a b},r.edge a b → signedValue terms a ≤ signedValue terms b) ↔
    (r.system.quotient p).Consistent := by
  classical
  constructor
  · rintro ⟨terms,hg,ht⟩
    exact r.consistent_of_generated p terms hg ht
  · intro h
    let V := Bool × I × (p→Bool)
    letI : Fintype V := by dsimp [V]; infer_instance
    letI : LinearOrder V := LinearOrder.lift' (Fintype.equivFin V) (Fintype.equivFin V).injective
    exact r.finite_model_reify_property p ((r.system.quotient p).canonical_model h)
      (LatticeGenerated p) (fun _ => .atom) (fun _ _ => .sup) (fun _ _ => .inf)

end ModalityInference.ComparisonObserverChains
