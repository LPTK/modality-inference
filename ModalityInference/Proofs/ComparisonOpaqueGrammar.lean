import ModalityInference.Proofs.ComparisonSkeletonLeafCoordinates
import ModalityInference.Proofs.ComparisonControls
import ModalityInference.Proofs.ComparisonWitnessProperties

namespace ModalityInference.ComparisonControls

open ComparisonInterpolation

/-- At an opaque solved shape, every well-shaped internal term is generated by
opaque variables, joins, meets, and modal actions. No normalization premise is
required. -/
theorem generated_of_shape {Δ : Bounds} {φ : TypeVar → ComparisonShape}
    (hφ : ComparisonShape.Models Δ φ) {s : TypeVar} {b : Basis} {a : CompareTy}
    (hs : a.WellShaped Δ) (ha : a.shape.subst φ = .var s)
    (hh : ∀v, φ v = .var s → .var v ∈ b.heads)
    (hm : Supports (fun _ => True) (· ∈ b.modes) a) :
    ∃e : Generated b, e.term = a := by
  induction a with
  | var v => exact ⟨.head (.var v) (hh v ha), rfl⟩
  | unit | credit | prod | sum | fn => simp [CompareTy.shape, ComparisonShape.subst] at ha
  | join a d iha ihd =>
    obtain ⟨left, hl⟩ := iha hs.1 ha hm.1
    obtain ⟨right, hr⟩ := ihd hs.2.1 ((hs.2.2 φ hφ).symm.trans ha) hm.2
    exact ⟨.join left right, by simp only [Generated.term, hl, hr]⟩
  | meet a d iha ihd =>
    obtain ⟨left, hl⟩ := iha hs.1 ha hm.1
    obtain ⟨right, hr⟩ := ihd hs.2.1 ((hs.2.2 φ hφ).symm.trans ha) hm.2
    exact ⟨.meet left right, by simp only [Generated.term, hl, hr]⟩
  | modal a m ih =>
    obtain ⟨e, he⟩ := ih hs ha hm.1
    exact ⟨.modal e m (fun v hv => hm.2 v ((m.mem_freeVariables v).mp hv)),
      by simp only [Generated.term, he]⟩

end ModalityInference.ComparisonControls

namespace ModalityInference.ComparisonShapeSolver

/-- A solved opaque class cannot acquire a variable outside the declared
support and one of its supplied heads. -/
theorem unify_class_predicate {fuel : Nat} {Δ : Bounds} {fixed : Assignment}
    (h : unify fuel (fun _ => true) (ComparisonShape.pairs Δ) = .success fixed)
    (P : TypeVar → Prop) (hP : ∀v∈Δ.typeVars, P v)
    {head v s : TypeVar} (hhead : P head)
    (hh : action fixed head = .var s) (hv : action fixed v = .var s) : P v := by
  obtain ⟨hf, hs⟩ := unify_support h Δ.typeVars (by rw [vars_pairs])
  by_cases hm : v ∈ Δ.typeVars
  · exact hP v hm
  have he : v = s := ComparisonShape.var.inj ((hf v hm).symm.trans hv)
  subst v
  by_cases hhmem : head ∈ Δ.typeVars
  · apply hP s
    apply hs head hhmem
    simp [hh, ComparisonShape.vars]
  · have he : head = s := ComparisonShape.var.inj ((hf head hhmem).symm.trans hh)
    exact he ▸ hhead

end ModalityInference.ComparisonShapeSolver

namespace ModalityInference.ComparisonGroups

/-- Every fixed input head in the selected class is retained by collection. -/
theorem collect_head_iff {p : SchemePreparation.Prepared} {shapes : ComparisonShapeSolver.Solved}
    {templates : ComparisonSkeleton.Templates} {reduced : ComparisonReduction.State}
    {groups : List Group} (h : collect p shapes templates reduced = .success groups)
    {g : Group} (hg : g ∈ groups) (v : TypeVar) :
    v ∈ g.heads ↔
      v ∈ p.assumptions.typeVariables ++ p.targetType.typeVariables ++
        p.sourceType.typeVariables ++ p.sourceBounds.typeVariables ∧
      ComparisonShapeSolver.sourceAllowed p v = false ∧
      shapeClass shapes templates v = some g.shapeClass := by
  unfold collect at h
  simp only [bind, pure, RunResult.bind] at h
  repeat' first
    | contradiction
    | (split at h <;> try simp only at h)
  · cases h
    obtain ⟨c, hc, rfl⟩ := List.mem_map.mp hg
    simp
    tauto
  · have hnone := RunResult.forIn_preserves
      (fun r : MProd (Option (List Group)) PUnit => r.fst = none) (by assumption) rfl (by
        intro pair hp before after hb hs
        repeat' first
          | contradiction
          | (cases hs; rfl)
          | (split at hs <;> try simp only at hs))
    simp_all

theorem shapeClass_fixed_of {shapes : ComparisonShapeSolver.Solved}
    {templates : ComparisonSkeleton.Templates} {v c : TypeVar}
    (hfresh : ∀leaf∈templates.leaves, v ≠ .flex leaf.name)
    (h : shapes.fixedShapes v = .var c) : shapeClass shapes templates v = some c := by
  cases v with
  | rigid n => simp only [shapeClass, h]
  | flex n =>
    have hn : templates.leaves.find? (fun leaf => leaf.name == n) = none := by
      apply List.find?_eq_none.mpr
      intro leaf hl
      have hne : leaf.name ≠ n := fun he => hfresh leaf hl (he ▸ rfl)
      simpa only [beq_iff_eq] using hne
    simp only [shapeClass, hn, h]

/-- A successful collection contains every variable in one of its opaque
classes, including all variables that can occur in an arbitrary well-shaped
internal image of that class. -/
theorem collect_class_heads {fuel : Nat} {p : SchemePreparation.Prepared}
    {shapes : ComparisonShapeSolver.Solved} {templates : ComparisonSkeleton.Templates}
    {reduced : ComparisonReduction.State} {groups : List Group}
    (hshape : ComparisonShapeSolver.prepare fuel p = .success (.solved shapes))
    (h : collect p shapes templates reduced = .success groups)
    (hscope : ∀v∈p.assumptions.typeVars, ComparisonShapeSolver.sourceAllowed p v = false)
    (hfresh : ∀leaf∈templates.leaves,
      ∀v∈p.assumptions.typeVariables ++ p.targetType.typeVariables ++
        p.sourceType.typeVariables ++ p.sourceBounds.typeVariables, v ≠ .flex leaf.name)
    {g : Group} (hg : g ∈ groups) {head : TypeVar} (hhead : head ∈ g.heads) :
    ∀v, shapes.fixedShapes v = .var g.shapeClass → v ∈ g.heads := by
  obtain ⟨hhmem, hhs, hhc⟩ := (collect_head_iff h hg head).mp hhead
  have hh := shapeClass_fixed (fun leaf hl => hfresh leaf hl head hhmem) hhc
  intro v hv
  have hp := ComparisonShapeSolver.unify_class_predicate
    (ComparisonShapeSolver.prepare_solved_iff.mp hshape).1
    (fun w => w ∈ p.assumptions.typeVariables ++ p.targetType.typeVariables ++
      p.sourceType.typeVariables ++ p.sourceBounds.typeVariables ∧
      ComparisonShapeSolver.sourceAllowed p w = false)
    (fun w hw => ⟨by simp [Bounds.mem_typeVariables, hw], hscope w hw⟩)
    ⟨hhmem, hhs⟩ hh hv
  exact (collect_head_iff h hg v).mpr
    ⟨hp.1, hp.2, shapeClass_fixed_of (fun leaf hl => hfresh leaf hl v hp.1) hv⟩

/-- Arbitrary images of an actual collected opaque class lie in its finite-head
modal grammar whenever their modality names are among the supplied controls. -/
theorem collect_generated {fuel : Nat} {p : SchemePreparation.Prepared}
    {shapes : ComparisonShapeSolver.Solved} {templates : ComparisonSkeleton.Templates}
    {reduced : ComparisonReduction.State} {groups : List Group}
    (hshape : ComparisonShapeSolver.prepare fuel p = .success (.solved shapes))
    (h : collect p shapes templates reduced = .success groups)
    (hscope : ∀v∈p.assumptions.typeVars, ComparisonShapeSolver.sourceAllowed p v = false)
    (hfresh : ∀leaf∈templates.leaves,
      ∀v∈p.assumptions.typeVariables ++ p.targetType.typeVariables ++
        p.sourceType.typeVariables ++ p.sourceBounds.typeVariables, v ≠ .flex leaf.name)
    {g : Group} (hg : g ∈ groups) {first : TypeVar} {rest : List TypeVar}
    (hheads : g.heads = first :: rest) {a : CompareTy}
    (hs : a.WellShaped p.assumptions)
    (ha : ComparisonShape.Equivalent p.assumptions a.shape (.var g.shapeClass))
    (hm : ComparisonInterpolation.Supports (fun _ => True)
      (· ∈ ComparisonElimination.groupModes p.assumptions reduced.modes g) a) :
    ∃e : ComparisonControls.Generated
      (ComparisonElimination.groupBasis p.assumptions reduced.modes g first rest), e.term = a := by
  have hfirst : first ∈ g.heads := hheads ▸ List.mem_cons_self
  obtain ⟨hfm, _, hfc⟩ := collect_head_origin h g hg first hfirst
  have hfirstShape := shapeClass_fixed (fun leaf hl => hfresh leaf hl first hfm) hfc
  have hfixed := (ComparisonShapeSolver.prepare_solved_iff.mp hshape).1
  have hφ := ComparisonShapeSolver.unify_sound hfixed
  have hi := ComparisonShapeSolver.unify_factor hfixed hφ first
  change (shapes.fixedShapes first).subst shapes.fixedShapes = shapes.fixedShapes first at hi
  rw [hfirstShape] at hi
  have hclass : shapes.fixedShapes g.shapeClass = .var g.shapeClass := hi
  apply ComparisonControls.generated_of_shape hφ hs ((ha _ hφ).trans hclass)
  · intro v hv
    have hm := collect_class_heads hshape h hscope hfresh hg hfirst v hv
    change CompareTy.var v ∈ CompareTy.var first :: rest.map CompareTy.var
    rw [hheads] at hm
    simpa only [List.map_cons] using List.mem_map.mpr ⟨v, hm, rfl⟩
  · exact hm

end ModalityInference.ComparisonGroups
